# Copie este arquivo para ".env" e preencha.
PORT=3000
# Texto longo e aleatório (protege o login). Ex.: gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# E-mail de envio (Gmail com "senha de app"). Se deixar vazio, o código de
# recuperação aparece no terminal do servidor (modo de teste).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
MAIL_FROM=Farmácia Santana <seuemail@gmail.com>
